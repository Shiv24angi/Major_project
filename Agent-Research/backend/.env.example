# Crawler Politeness & Limits
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; NiveshResearchBot/1.0; +https://nivesh.ai/bot)
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_PAGES_PER_DOMAIN=5
CRAWLER_MAX_CONCURRENT=3

